// Allocation boundary. Implementations can later move behind a target-aware
// runtime while keeping these names stable for collections.

module std {
    module alloc {
        use std::libc;

        pub trait Allocator<T> {
            pub func allocate(self: *T, size: uint) -> ptr;
            pub func deallocate(self: *T, buffer: ptr);
            pub func grow(self: *T, buffer: ptr, size: uint) -> ptr;
        }
    }
}
