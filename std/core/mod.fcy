// Core language-level contracts and value types.
// This file deliberately has no allocator or operating-system dependency.

module std {
    module core {
        module num {
            pub func abs(value: int) -> int {
                if value < 0 { return -value; }
                return value;
            }

            pub func clamp(value: int, lower: int, upper: int) -> int {
                if value < lower { return lower; }
                if value > upper { return upper; }
                return value;
            }
        }

        module cmp {
            pub func max(a: int, b: int) -> int {
                if a > b { return a; }
                return b;
            }

            pub func min(a: int, b: int) -> int {
                if a < b { return a; }
                return b;
            }
        }

        pub enum Ordering {
            Less,
            Equal,
            Greater,
        }

        pub enum Option<T> {
            Some(T),
            None,
        }

        pub enum Result<T, E> {
            Ok(T),
            Err(E),
        }

        pub trait Eq<T> {
            pub func eq(self: *T, other: *T) -> bool;
        }

        pub trait Ge<T> {
            pub func ge(self: *T, other: *T) -> bool;
        }

        pub trait Gt<T> {
            pub func gt(self: *T, other: *T) -> bool;
        }

        pub trait Le<T> {
            pub func le(self: *T, other: *T) -> bool;
        }

        pub trait Lt<T> {
            pub func lt(self: *T, other: *T) -> bool;
        }

        pub trait Ord<T> {
            pub func cmp(self: *T, other: *T) -> int;
        }

        pub trait Clone<T> {
            pub func clone(self: *T) -> *T;
        }

        pub trait Drop<T> {
            pub func drop(self: *T);
        }

        pub trait Default<T> {
            pub func default() -> *T;
        }
    }
}
