pub extern func printf(format: str, ...) -> i32;

union Value {
    pub integer: int
    floating: double
}

enum Result {
    Ok(int),
    Err(str),
    None,
}

func main(argc: uint, argv: [str]) -> int {
    let value = Value { integer: 3; };
    main::printf("%ld\n", value.integer);

    let result = Result::Ok(7);
    return 0;
}
