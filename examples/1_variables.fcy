pub extern func printf(format: str, ...) -> i32;

func main() {
    let uvar: uint = 10u; // declaring unsigned integer (64 bit)
    let ivar: int = -5; // declaring signed integer (64 bit)
    let fvar: double = 3.14; // declaring floating point variable (double precision)
    let fvar2 = 3.14; // auto type infer also supported (double here)

    let iwv: i32 = -15i; // signed 32bit  integer 
    let uwv: u32 = 16uw; // unsigned 32 bit integer 
    let ubv: ubyte = 255ub; // unsigned byte
    let ibv: ibyte = -120ib; // signed byte

    let fvar_sq: double = fvar * fvar;
    let ivar_negated: int = -ivar;

    let uvar_from_fvar: uint = fvar$uint; // lossy 
    let fvar_from_uvar: double = uvar$double; // $ to convert types

    let some_ops: double = fvar_from_uvar * (2.0 + 1.0);
    some_ops -= 2.5; // subtract and assign

    // Printing through the C variadic interface (later std::print).
    main::printf("%f\n", fvar_sq);
    main::printf("%ld\n", ivar_negated);
    main::printf("%lu\n", uvar_from_fvar);
    main::printf("%f\n", fvar_from_uvar);
    main::printf("%f\n", some_ops);

    return;
}
