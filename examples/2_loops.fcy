pub extern func printf(format: str, ...) -> i32;

func main() {
    // endless loop (not really)
    while true {
        main::printf("%ld\n", 0);
        break;
    }

    // silly stuff 
    while true break;

    // lets print every integer from 0 to 10 exclusively
    for let a: int = 0 in a < 10; a += 1 {
        main::printf("%ld\n", a);
    }

    // shorter way
    for let a: int = 0 in a < 10; a += 1 main::printf("%ld\n", a);

    return;
}
