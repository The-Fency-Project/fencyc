enum Result {
    Ok(int),
    Err(str),
    None,
}

func main(argc: uint, argv: [str]) -> int {
    let x = 2;
    match x {
        1 => { printintrin 10; }
        2 => { printintrin 20; }
        _ => { printintrin 30; }
    }

    let result: Result = Result::Ok(2);
    let tag: uint = result$uint;
    printintrin tag;
    let payload = match result {
        Result::Ok(v) => { v + 1; }
        Result::None => { 0; }
        _ => { 0; }
    };
    printintrin payload;
    return 0;
}
