module other {
    pub func print_hello() {
        main::printf("%s\n", "Hello, modules!");
        return;
    }

    module submod {
        pub func print_bye() {
            main::printf("%s\n", "Goodbye!");
            return;
        }

        pub overload func print_bye(i: int) {
            main::printf("%s\n", "Goodbye!");
            // Private function is available from the same module
            let val: int = add1(i);
            main::printf("%ld\n", val);
            return;
        }

        func add1(i: int) -> int {
            return i + 1;
        }
    }
}
