pub extern func printf(format: str, ...) -> i32;

module std { module core { module atomic {
    pub struct Uint { pub value: uint }
    pub extern func add_uint(address: *Uint, value: uint, ordering: uint) -> uint;
} } }

func main() {
    let counter = std::core::atomic::Uint { value: 1u; };
    let previous = std::core::atomic::add_uint(&counter, 2u, 4u);
    printf("%lu %lu\n", previous, counter.value);
    return;
}
